    "react-router-dom": "^7.18.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
